 }
 #endif
 
+#if CONFIG_M17_PTT_TEST
+static const air_profile_t m17_profile = {
+	.sym_rate = 4800, .levels = 4, .shape = AIR_SHAPE_RRC, .shape_param = 50,
+	.dev_outer_hz = 2400, .timing = AIR_TIMING_CONTINUOUS, .bw = RADIO_BW_12K5, .idle = 0x77,
+};
+
+enum { M17_PTT = 1, M17_ARM = 2, M17_CAP_MS = 650 };
+
+// Read the physical contacts before key injection or user remapping.
+static unsigned m17_keys(void)
+{
+	uint32_t raw = input_raw_keys();
+	unsigned keys = 0;
+	for (unsigned i = 0; i < board.keymap_len; i++) {
+		const keymap_entry_t *key = &board.keymap[i];
+		if ((raw & (1u << key->bit)) != 0) {
+			if (key->short_action == ACT_PTT)
+				keys |= M17_PTT;
+			if (key->short_action == ACT_MONITOR)
+				keys |= M17_ARM;
+		}
+	}
+	return keys;
+}
+
+static bool m17_vfo(const radio_sm_t *sm)
+{
+	return sm->view.vfo && sm->view.ch.mode == RADIO_MODE_FM && sm->view.ch.tx_hz == sm->view.ch.rx_hz &&
+	       sm->view.scan == 0 && !sm->hotspot;
+}
+
+static void m17_event(const air_event_t *ev, void *ctx)
+{
+	radio_sm_t *sm = ctx;
+	if (ev->kind == AIR_EV_TX_DONE || ev->kind == AIR_EV_TX_UNDERRUN)
+		__atomic_store_n(&sm->m17_stop, true, __ATOMIC_RELEASE);
+}
+
+static bool m17_fill(radio_sm_t *sm)
+{
+	air_tx_chunk_t c = { .nsyms = AIR_CHUNK_SYMS_MAX };
+	_Static_assert(sizeof(m17_test_burst) % sizeof(c.syms) == 0, "whole modem chunks");
+	while (sm->m17_offset < sizeof(m17_test_burst) && board.air->tx_space() > 0) {
+		memcpy(c.syms, m17_test_burst + sm->m17_offset, sizeof(c.syms));
+		c.flags = sm->m17_offset + sizeof(c.syms) == sizeof(m17_test_burst) ? AIR_TX_LAST : 0;
+		if (!board.air->tx_queue(&c))
+			return false;
+		sm->m17_offset += sizeof(c.syms);
+	}
+	return true;
+}
+
+static void m17_close(radio_sm_t *sm, uint32_t now_ms)
+{
+	if (sm->m17_open) {
+		board.air->tx_abort();
+		bench_unkey(sm);
+		board.air->close();
+		sm->m17_open = false;
+	}
+	bench_leave(sm, now_ms);
+}
+
+static void m17_press(radio_sm_t *sm, int arg, uint32_t now_ms)
+{
+	if (arg == 0) {
+		if (sm->m17_open)
+			m17_close(sm, now_ms);
+		return;
+	}
+	bool armed = sm->m17_armed;
+	sm->m17_armed = false;
+	if (!armed || arg != RADIO_PTT_LOCAL_TEST || !m17_vfo(sm) || sm->view.state != RS_IDLE ||
+	    m17_keys() != (M17_ARM | M17_PTT) || ptt_line_stuck() || tx_check(sm) != TXDENY_NONE ||
+	    board.air == NULL || board.air->tx_chunk_syms != AIR_CHUNK_SYMS_MAX ||
+	    (board.air->fit(&m17_profile) & AIR_FIT_TX) == 0)
+		return;
+	activity(sm, now_ms);
+	bench_enter(sm, now_ms);
+	if (!sm->air_bench)
+		return;
+	sm->m17_offset = 0;
+	__atomic_store_n(&sm->m17_stop, false, __ATOMIC_RELEASE);
+	sm->m17_open = board.air->open(&m17_profile, m17_event, sm);
+	if (sm->m17_open && m17_fill(sm) && sm->m17_offset > 0 && m17_keys() == (M17_ARM | M17_PTT))
+		bench_key(sm, M17_CAP_MS, now_ms);
+	if (!sm->bench_keyed)
+		m17_close(sm, now_ms);
+}
+
+static void m17_tick(radio_sm_t *sm, uint32_t now_ms)
+{
+	unsigned keys = m17_keys();
+	if (!sm->m17_open) {
+		if (keys != (M17_ARM | M17_PTT))
+			sm->m17_armed = keys == M17_ARM && m17_vfo(sm);
+		return;
+	}
+	bench_tick(sm, now_ms);
+	if (!sm->bench_keyed || keys != (M17_ARM | M17_PTT) || ptt_line_stuck() || tx_held(sm) ||
+	    !tx_limit_allows(sm->view.ch.tx_hz) || __atomic_load_n(&sm->m17_stop, __ATOMIC_ACQUIRE) || !m17_fill(sm))
+		m17_close(sm, now_ms);
+}
+#endif
+
