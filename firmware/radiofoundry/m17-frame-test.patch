@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+#include "debuglink/dl_fmt.h"
+#include "m17/m17_frame.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+void debuglink_view_m17(dl_text_t *t);
+
+int main(void)
+{
+	// Byte-for-byte gr-m17 loopback capture at the lab's pinned reference revision.
+	static const char expected[] =
+		"m17.lsf=55f7d73562d0caf68d5afb0e8680cabacd670ec01653d10be876642333dc146adaf20d0dd286f5338713f318a92d59c3\n"
+		"m17.stream0=ff5dd7b4c230a25fe4c23a0f569991d8f55d0dd97273a15db86e782f3d9212a2c56e1191dd04c32197014598a92c7ec0\n";
+	char text[256];
+	dl_text_t t;
+	dl_text_init(&t, text, sizeof(text));
+	debuglink_view_m17(&t);
+	assert(!t.full && t.len == sizeof(expected) - 1);
+	assert(memcmp(text, expected, t.len) == 0);
+	uint8_t fragment[5] = {0}, payload[16] = {0}, frame[48] = {0};
+	assert(!m17_stream_frame(fragment, 6, 0, payload, frame));
+	puts("m17FrameTest: both captured frames matched");
+	return 0;
+}
